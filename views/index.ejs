<html>
    <body>
       <!-- Inside index.ejs body -->
        <h1><%= title %></h1>
        <a href="/new">create New</a>

        <form action="/" method="GET">
  <input type="text" name="search" placeholder="Search usernames...">
  <button type="submit">Search</button>
</form>
<ul>
  <% messages.forEach((message)=> { %>
    <li>
      <strong>User:</strong> <%= message.username %> <br>
      <strong>Message:</strong> <%= message.text %> <br>
      <strong>Added:</strong> <%= message.added %>
    </li>
    <!-- Add this Delete Form -->
    <form action="/delete/<%= message.id %>" method="POST">
      <button type="submit">Delete</button>
    </form>
  <% }) %>
</ul>
    </body>
</html>